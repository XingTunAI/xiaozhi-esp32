{
    "manufacturer": "waveshare",
    "type": "esp32-p4-wifi6-dev-kit-b",
    "target": "esp32p4",
    "builds": [
        {
            "name": "esp32-p4x-wifi6-dev-kit-b-screen",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_DEV_KIT_B=y",
                "CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n",
                "CONFIG_ESP32P4_REV_MIN_300=y",
                "CONFIG_USE_WECHAT_MESSAGE_STYLE=n",
                "CONFIG_USE_WAKE_WORD_DETECT=n",
                "CONFIG_USE_DEVICE_AEC=n",
                "CONFIG_USE_AUDIO_PROCESSOR=n",
                "CONFIG_VOICE_LAB_STANDALONE_MODE=y",
                "CONFIG_USB_HOST_HUBS_SUPPORTED=y",
                "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512",
                "CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072",
                "CONFIG_LV_USE_KEYBOARD=y",
                "CONFIG_VOICE_LAB_SERVER_PORT=443",
                "CONFIG_VOICE_LAB_DEVICE_KEY_PREFIX=\"p4-terminal-\"",
                "CONFIG_VOICE_LAB_HARDWARE_PROFILE=\"esp32-p4-wifi6-dev-kit-b\"",
                "CONFIG_VOICE_LAB_AUDIO_FRONTEND=\"xvf3800-usb-uac2\"",
                "CONFIG_VOICE_LAB_AUDIO_FRONTEND_FIRMWARE=\"xvf3800-usb-version-unverified\"",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"main/boards/waveshare/esp32-p4-wifi6-dev-kit-b/partitions.csv\"",
                "CONFIG_VOICE_LAB_DEVICE_KEY_USE_BASE_MAC=y"
            ]
        }
    ]
}
